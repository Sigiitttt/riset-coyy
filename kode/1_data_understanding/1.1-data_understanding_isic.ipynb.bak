   "source": [
    "# ==============================================================================\n",
    "# LANGKAH 9: SLICING & PATIENT-LEVEL SPLITTING ISIC 2024 (BEBAS DATA LEAKAGE)\n",
    "# ==============================================================================\n",
    "\n",
    "import os\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from sklearn.model_selection import GroupShuffleSplit\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# ------------------------------------------------------------------------------\n",
    "# 1. LOAD DATA: Membaca file metadata.csv & GroundTruth ISIC 2024\n",
    "# ------------------------------------------------------------------------------\n",
    "# Menentukan path lokasi metadata dan ground truth ISIC 2024\n",
    "meta_path_2024 = os.path.join(ROOT, 'isic 2024', 'ISIC_2024_Training_Input', 'ISIC_2024_Training_Input', 'metadata.csv')\n",
    "gt_path_2024 = os.path.join(ROOT, 'isic 2024', 'ISIC_2024_Training_Input', 'ISIC_2024_Training_GroundTruth.csv')\n",
    "\n",
    "print(\"1. Membaca metadata ISIC 2024...\")\n",
    "df_meta_2024 = pd.read_csv(meta_path_2024)\n",
    "\n",
    "# Memastikan kolom 'target' (1: Kanker/Malignant, 0: Jinak/Benign) tersedia\n",
    "if 'target' not in df_meta_2024.columns:\n",
    "    if 'malignant' in df_meta_2024.columns:\n",
    "        # Jika kolom malignant sudah ada, konversi langsung menjadi integer (0 atau 1)\n",
    "        df_meta_2024['target'] = df_meta_2024['malignant'].astype(int)\n",
    "    elif os.path.exists(gt_path_2024):\n",
    "        # Jika belum ada di metadata, gabungkan (merge) dengan GroundTruth berdasarkan ID gambar\n",
    "        df_gt_2024 = pd.read_csv(gt_path_2024)\n",
    "        id_col = 'isic_id' if 'isic_id' in df_gt_2024.columns else df_gt_2024.columns[0]\n",
    "        df_meta_2024 = pd.merge(df_meta_2024, df_gt_2024[[id_col, 'malignant']], on=id_col, how='inner')\n",
    "        df_meta_2024['target'] = df_meta_2024['malignant'].astype(int)\n",
    "\n",
    "# Tampilkan ringkasan data asli ISIC 2024 sebelum dislice\n",
    "print(f\"   [INFO] Total baris data asli ISIC 2024 : {len(df_meta_2024):,} baris\")\n",
    "print(f\"   [INFO] Total pasien unik asli          : {df_meta_2024['patient_id'].nunique():,} pasien\")\n",
    "print(f\"   [INFO] Jumlah data Kanker (target=1)   : {(df_meta_2024['target'] == 1).sum():,} baris\")\n",
    "print(f\"   [INFO] Jumlah data Jinak (target=0)    : {(df_meta_2024['target'] == 0).sum():,} baris\")\n",
    "\n",
    "# ------------------------------------------------------------------------------\n",
    "# 2. SLICING & BALANCING UKURAN DATA (SUBSET SLICING 1:1)\n",
    "# ------------------------------------------------------------------------------\n",
    "# Filter 100% data yang tergolong kanker/ganas (target == 1)\n",
    "df_cancer = df_meta_2024[df_meta_2024['target'] == 1].copy()\n",
    "n_cancer = len(df_cancer)\n",
    "\n",
    "# Ambil sampel acak data jinak (target == 0) dengan jumlah yang PERSIS SAMA (1:1)\n",
    "df_benign_sampled = df_meta_2024[df_meta_2024['target'] == 0].sample(n=n_cancer, random_state=42).copy()\n",
    "\n",
    "# Gabungkan data kanker dan data jinak yang sudah seimbang ke dalam satu DataFrame baru\n",
    "df_sliced_2024 = pd.concat([df_cancer, df_benign_sampled], ignore_index=True)\n",
    "\n",
    "# Acak (shuffle) seluruh baris agar urutan target tercampur secara merata\n",
    "df_sliced_2024 = df_sliced_2024.sample(frac=1.0, random_state=42).reset_index(drop=True)\n",
    "\n",
    "print(\"\\n2. Hasil Slicing & Balancing Data (1:1):\")\n",
    "print(f\"   [OK] Total baris dataset ringkas       : {len(df_sliced_2024):,} baris\")\n",
    "print(f\"   [OK] Komposisi Kelas                   : {n_cancer:,} Kanker (50%) & {n_cancer:,} Jinak (50%)\")\n",
    "print(f\"   [OK] Jumlah Pasien Unik di Subset      : {df_sliced_2024['patient_id'].nunique():,} pasien\")\n",
    "\n",
    "# ------------------------------------------------------------------------------\n",
    "# 3. SLICING & SPLITTING BERBASIS PASIEN (PATIENT-LEVEL GROUP SPLITTING)\n",
    "# ------------------------------------------------------------------------------\n",
    "# Gunakan GroupShuffleSplit untuk membagi 80% Train dan 20% Test berdasarkan 'patient_id'\n",
    "# Ini menjamin seluruh foto milik pasien X HANYA masuk ke Train atau HANYA masuk ke Test\n",
    "splitter = GroupShuffleSplit(n_splits=1, test_size=0.20, random_state=42)\n",
    "\n",
    "# Eksekusi splitting dengan mengunci kelompok 'patient_id'\n",
    "train_indices, test_indices = next(splitter.split(df_sliced_2024, groups=df_sliced_2024['patient_id']))\n",
    "\n",
    "# Bentuk DataFrame Train dan Test\n",
    "df_train_2024 = df_sliced_2024.iloc[train_indices].copy().reset_index(drop=True)\n",
    "df_test_2024 = df_sliced_2024.iloc[test_indices].copy().reset_index(drop=True)\n",
    "\n",
    "print(\"\\n3. Hasil Splitting Berbasis Pasien (Patient-Level 80:20):\")\n",
    "print(f\"   [TRAIN] Data Latihan : {len(df_train_2024):,} baris ({df_train_2024['patient_id'].nunique():,} pasien unik)\")\n",
    "print(f\"   [TEST]  Data Ujian   : {len(df_test_2024):,} baris ({df_test_2024['patient_id'].nunique():,} pasien unik)\")\n",
    "\n",
    "# ------------------------------------------------------------------------------\n",
    "# 4. KODE VERIFIKASI KEBOCORAN DATA (SET INTERSECTION PADA PATIENT_ID)\n",
    "# ------------------------------------------------------------------------------\n",
    "# Ambil himpunan (set) ID pasien dari data Train dan data Test\n",
    "set_patient_train = set(df_train_2024['patient_id'])\n",
    "set_patient_test = set(df_test_2024['patient_id'])\n",
    "\n",
    "# Hitung irisan matematika antara kedua himpunan pasien\n",
    "patient_overlap = set_patient_train.intersection(set_patient_test)\n",
    "\n",
    "# Evaluasi apakah benar-benar bebas kebocoran (jumlah overlap harus 0)\n",
    "is_clean_from_leakage = (len(patient_overlap) == 0)\n",
    "\n",
    "print(\"\\n4. Hasil Verifikasi Logika Bebas Kebocoran Data (Data Leakage):\")\n",
    "print(f\"   -> Jumlah Pasien di Train          : {len(set_patient_train):,} pasien\")\n",
    "print(f\"   -> Jumlah Pasien di Test           : {len(set_patient_test):,} pasien\")\n",
    "print(f\"   -> Pasien Tumpang Tindih (Overlap) : {len(patient_overlap)} pasien\")\n",
    "\n",
    "if is_clean_from_leakage:\n",
    "    print(\"   -> KESIMPULAN: [VALID & AMAN] 100% Bebas Kebocoran Data (Zero Leakage)!\")\n",
    "    print(\"      Tidak ada satu pun foto dari pasien yang sama yang muncul di Train dan Test.\")\n",
    "else:\n",
    "    print(f\"   -> KESIMPULAN: [BAHAYA] Ditemukan kebocoran data pada pasien: {patient_overlap}\")\n",
    "\n",
    "# ------------------------------------------------------------------------------\n",
    "# 5. LAPORAN OUTPUT & TABEL RINGKASAN\n",
    "# ------------------------------------------------------------------------------\n",
    "laporan_split = pd.DataFrame([\n",
    "    {\n",
    "        'Kelompok Data': 'Train (Data Latihan)',\n",
    "        'Jumlah Baris': len(df_train_2024),\n",
    "        'Pasien Unik': df_train_2024['patient_id'].nunique(),\n",
    "        'Kanker (Target=1)': (df_train_2024['target'] == 1).sum(),\n",
    "        'Jinak (Target=0)': (df_train_2024['target'] == 0).sum(),\n",
    "        '% Kanker': f\"{((df_train_2024['target'] == 1).mean() * 100):.1f}%\"\n",
    "    },\n",
    "    {\n",
    "        'Kelompok Data': 'Test (Data Ujian)',\n",
    "        'Jumlah Baris': len(df_test_2024),\n",
    "        'Pasien Unik': df_test_2024['patient_id'].nunique(),\n",
    "        'Kanker (Target=1)': (df_test_2024['target'] == 1).sum(),\n",
    "        'Jinak (Target=0)': (df_test_2024['target'] == 0).sum(),\n",
    "        '% Kanker': f\"{((df_test_2024['target'] == 1).mean() * 100):.1f}%\"\n",
    "    },\n",
    "    {\n",
    "        'Kelompok Data': 'TOTAL SUBSET',\n",
    "        'Jumlah Baris': len(df_sliced_2024),\n",
    "        'Pasien Unik': df_sliced_2024['patient_id'].nunique(),\n",
    "        'Kanker (Target=1)': (df_sliced_2024['target'] == 1).sum(),\n",
    "        'Jinak (Target=0)': (df_sliced_2024['target'] == 0).sum(),\n",
    "        '% Kanker': f\"{((df_sliced_2024['target'] == 1).mean() * 100):.1f}%\"\n",
    "    }\n",
    "])\n",
    "\n",
    "print(\"\\n===================== TABEL DISTRIBUSI HASIL SLICING ISIC 2024 =====================\\n\")\n",
    "display(laporan_split)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "200a78c0",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 800x450 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# visualisasi perbandingan distribusi kelas pada data Train dan Test\n",
    "fig, ax = plt.subplots(figsize=(8, 4.5))\n",
    "classes = ['Jinak (0)', 'Kanker (1)']\n",
    "train_counts = [(df_train_2024['target'] == 0).sum(), (df_train_2024['target'] == 1).sum()]\n",
    "test_counts = [(df_test_2024['target'] == 0).sum(), (df_test_2024['target'] == 1).sum()]\n",
    "\n",
    "x = np.arange(len(classes))\n",
    "width = 0.35\n",
    "\n",
    "rects1 = ax.bar(x - width/2, train_counts, width, label='Train Set (80%)', color='#2b5c8f')\n",
    "rects2 = ax.bar(x + width/2, test_counts, width, label='Test Set (20%)', color='#e67e22')\n",
    "\n",
    "# tambahkan label angka di atas batang\n",
    "for rect in rects1:\n",
    "    h = rect.get_height()\n",
    "    ax.text(rect.get_x() + rect.get_width()/2., h + 5, f'{int(h)}', ha='center', va='bottom', fontweight='bold', color='#1a3d61')\n",
    "\n",
    "for rect in rects2:\n",
    "    h = rect.get_height()\n",
    "    ax.text(rect.get_x() + rect.get_width()/2., h + 5, f'{int(h)}', ha='center', va='bottom', fontweight='bold', color='#9c4d07')\n",
    "\n",
    "ax.set_title('Distribusi Kelas pada Train dan Test Set (ISIC 2024 Sliced)', fontsize=12, fontweight='bold')\n",
    "ax.set_xticks(x)\n",
    "ax.set_xticklabels(classes, fontsize=10)\n",
    "ax.set_ylabel('Jumlah Baris Data', fontsize=11)\n",
    "ax.set_ylim(0, max(train_counts) * 1.25)\n",
    "ax.legend(fontsize=10)\n",
    "ax.grid(axis='y', linestyle='--', alpha=0.5)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
