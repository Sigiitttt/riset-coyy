   "source": [
    "summary_class_rows = []\n",
    "\n",
    "for source, info in SOURCES.items():\n",
    "    fmt = info['gt_format']\n",
    "    gt = ground_truth_dfs.get(source)\n",
    "    if gt is None:\n",
    "        n_file = len(df_images[df_images['source'] == source])\n",
    "        summary_class_rows.append({\n",
    "            'Source': source,\n",
    "            'Total Data': f\"{n_file:,}\",\n",
    "            'Format': 'Unlabeled (Metadata)',\n",
    "            'Jumlah Kelas': 0,\n",
    "            'Daftar Kelas': 'Unlabeled Test Set (Challenge)',\n",
    "            'Jumlah Malignant': '-',\n",
    "            '% Malignant': '-'\n",
    "        })\n",
    "        continue\n",
    "        \n",
    "    total_samples = len(gt)\n",
    "    n_malignant = 0\n",
    "    class_names = []\n",
    "    \n",
    "    if fmt == '2016':\n",
    "        col = 'label'\n",
    "        m = (gt[col].astype(str).str.lower().isin(['malignant', '1.0', '1'])).sum()\n",
    "        n_malignant = m\n",
    "        class_names = ['benign', 'malignant']\n",
    "    elif fmt == '2017':\n",
    "        n_malignant = (gt['melanoma'] == 1.0).sum()\n",
    "        class_names = ['melanoma', 'seborrheic_keratosis', 'nevus']\n",
    "    elif fmt == 'onehot7':\n",
    "        cols = [c for c in gt.columns if c not in ('image_id', 'score_weight', 'validation_weight')]\n",
    "        class_names = cols\n",
    "        n_malignant = ((gt['MEL'] == 1.0) | (gt['BCC'] == 1.0) | (gt['AKIEC'] == 1.0)).sum()\n",
    "    elif fmt == 'onehot9':\n",
    "        cols = [c for c in gt.columns if c not in ('image_id', 'score_weight', 'validation_weight')]\n",
    "        class_names = cols\n",
    "        n_malignant = ((gt['MEL'] == 1.0) | (gt['BCC'] == 1.0) | (gt['AK'] == 1.0) | (gt['SCC'] == 1.0)).sum()\n",
    "    elif fmt == '2020':\n",
    "        n_malignant = (gt['target'] == 1).sum()\n",
    "        class_names = ['benign (0)', 'malignant (1)']\n",
    "    elif fmt == '2024':\n",
    "        n_malignant = (gt['malignant'] == 1.0).sum()\n",
    "        class_names = ['benign (0)', 'malignant (1)']\n",
    "    elif fmt == 'ham_dx':\n",
    "        n_malignant = gt['dx'].isin(['mel', 'bcc', 'akiec']).sum()\n",
    "        class_names = sorted(gt['dx'].unique().tolist())\n",
    "        \n",
    "    pct_mal = round(n_malignant / total_samples * 100, 2)\n",
    "    summary_class_rows.append({\n",
    "        'Source': source,\n",
    "        'Total Data': f\"{total_samples:,}\",\n",
    "        'Format': fmt,\n",
    "        'Jumlah Kelas': len(class_names),\n",
    "        'Daftar Kelas': ', '.join(class_names),\n",
    "        'Jumlah Malignant': f\"{n_malignant:,}\",\n",
    "        '% Malignant': f\"{pct_mal}%\"\n",
    "    })\n",
    "\n",
    "df_class_summary = pd.DataFrame(summary_class_rows)\n",
    "print(\"=== RINGKASAN JUMLAH KELAS & % MALIGNANT PER DATASET ===\")\n",
    "display(df_class_summary[['Source', 'Total Data', 'Format', 'Jumlah Kelas', '% Malignant', 'Daftar Kelas']])\n"
   ]
  },
